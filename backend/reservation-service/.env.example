# Server
PORT=3000
NODE_ENV=development

# Database (same pattern as existing config/database.js)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bookfair_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT – MUST match iam-service jwt.secret
JWT_SECRET=token_here

# External services
IAM_SERVICE_URL=http://localhost:8081
STALL_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:4003

# Service account (an ADMIN user created in iam-service)
SERVICE_ADMIN_EMAIL=your_email_here
SERVICE_ADMIN_PASSWORD=your_password_here

# Internal API key – must match notification-service .env
INTERNAL_API_KEY=bookfair_reservation_internal_B00kf@ir123

# Exhibition dates (for QR / email)
EXHIBITION_START=2026-01-10T09:00:00.000Z
EXHIBITION_END=2026-01-20T20:00:00.000Z
